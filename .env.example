# Copy this file to .env and fill in only the services you plan to use.
# .env is ignored by git. Never commit API keys or promo codes.

# Required for voice input, always-on listening, and optional ElevenLabs TTS.
ELEVENLABS_API_KEY= sk_8f18e24806f0a1d7b2f835b4a8896119ccdf8879a9c10d27


# Optional: ElevenLabs voice output configuration.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ORCUS_TTS=1

# Optional Gemini fallback for commands Laya/local rules do not resolve.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Dashboard/runtime defaults. `orcus` sets the first three to 1 if unset.
ORCUS_EXECUTE=1
ORCUS_ALWAYS_ON=1
ORCUS_GESTURE=1
ORCUS_WAKE_WORD=orca
ORCUS_COMMAND_TIMEOUT=30
ORCUS_LOCK_FILE=/tmp/orcus.lock

# Set to 1 for gesture capture diagnostics.
ORCUS_GESTURE_DEBUG=0
